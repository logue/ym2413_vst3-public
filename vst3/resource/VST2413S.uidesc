<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <fonts/>
  <colors>
    <color name="Case" rgba="#202631ff"/><color name="Case Edge" rgba="#0d1118ff"/>
    <color name="Panel" rgba="#39414bff"/><color name="Panel Light" rgba="#56616dff"/>
    <color name="Screen" rgba="#172b24ff"/><color name="LCD" rgba="#99d4aaff"/>
    <color name="Accent" rgba="#f0b43cff"/><color name="Ink" rgba="#e9e3d4ff"/>
    <color name="Muted" rgba="#aab1b8ff"/><color name="Switch" rgba="#29313aff"/>
  </colors>
  <control-tags>
    <control-tag name="AR0" tag="0"/><control-tag name="AR1" tag="1"/>
    <control-tag name="DR0" tag="2"/><control-tag name="DR1" tag="3"/>
    <control-tag name="SL0" tag="4"/><control-tag name="SL1" tag="5"/>
    <control-tag name="RR0" tag="6"/><control-tag name="RR1" tag="7"/>
    <control-tag name="MUL0" tag="8"/><control-tag name="MUL1" tag="9"/>
    <control-tag name="FB" tag="10"/><control-tag name="TL" tag="11"/>
    <control-tag name="DM" tag="12"/><control-tag name="DC" tag="13"/>
    <control-tag name="AM0" tag="14"/><control-tag name="AM1" tag="15"/>
    <control-tag name="VIB0" tag="16"/><control-tag name="VIB1" tag="17"/>
    <control-tag name="Wheel" tag="18"/><control-tag name="Tune" tag="19"/>
    <control-tag name="EG0" tag="20"/><control-tag name="EG1" tag="21"/>
    <control-tag name="KSR0" tag="22"/><control-tag name="KSR1" tag="23"/>
    <control-tag name="KSL0" tag="24"/><control-tag name="KSL1" tag="25"/>
  </control-tags>

  <template background-color="Case" background-color-draw-style="filled and stroked" class="CViewContainer" mouse-enabled="true" name="view" origin="0, 0" size="820, 730" transparent="false">
    <view back-color="Case Edge" class="CTextLabel" font="~ NormalFontVeryBig" font-color="Accent" frame-width="0" mouse-enabled="false" origin="18, 14" size="784, 42" style-no-frame="true" text-alignment="left" text-inset="14, 0" title="VST2413" transparent="false"/>
    <view back-color="Case Edge" class="CTextLabel" font="~ NormalFontSmaller" font-color="Muted" frame-width="0" mouse-enabled="false" origin="590, 23" size="195, 24" style-no-frame="true" text-alignment="right" title="YM2413 S / MSX MODE" transparent="true"/>

    <!-- Operator-independent patch parameters. -->
    <view background-color="Panel" background-color-draw-style="filled and stroked" class="CViewContainer" frame-color="Panel Light" frame-width="1" origin="18, 68" size="784, 120" transparent="false">
      <view back-color="Panel" class="CTextLabel" font="~ NormalFontSmall" font-color="Muted" frame-width="0" mouse-enabled="false" origin="15, 8" size="754, 20" style-no-frame="true" text-alignment="left" title="COMMON PATCH PARAMETERS" transparent="true"/>
      <view back-color="Panel" class="CTextLabel" font="~ NormalFontSmaller" font-color="Ink" frame-width="0" mouse-enabled="false" origin="100, 32" size="110, 18" style-no-frame="true" text-alignment="center" title="TOTAL LEVEL (TL)" transparent="true"/>
      <view angle-range="270" angle-start="135" circle-drawing="true" class="CKnob" control-tag="TL" corona-color="Accent" corona-drawing="true" corona-inset="6" default-value="0" handle-color="Ink" handle-line-width="3" origin="105, 52" size="50, 50" transparent="false" value-inset="7" wheel-inc-value="0.015873"/>
      <view back-color="Screen" class="CTextEdit" control-tag="TL" font="~ NormalFontSmaller" font-color="LCD" frame-color="Case Edge" frame-width="1" origin="160, 66" size="60, 22" text-alignment="center" transparent="false"/>
      <view back-color="Panel" class="CTextLabel" font="~ NormalFontSmaller" font-color="Ink" frame-width="0" mouse-enabled="false" origin="285, 32" size="110, 18" style-no-frame="true" text-alignment="center" title="FEEDBACK (FB)" transparent="true"/>
      <view angle-range="270" angle-start="135" circle-drawing="true" class="CKnob" control-tag="FB" corona-color="Accent" corona-drawing="true" corona-inset="6" default-value="0" handle-color="Ink" handle-line-width="3" origin="290, 52" size="50, 50" transparent="false" value-inset="7" wheel-inc-value="0.142857"/>
      <view back-color="Screen" class="CTextEdit" control-tag="FB" font="~ NormalFontSmaller" font-color="LCD" frame-color="Case Edge" frame-width="1" origin="345, 66" size="60, 22" text-alignment="center" transparent="false"/>
      <view back-color="Screen" class="CTextLabel" font="~ NormalFontSmaller" font-color="LCD" frame-color="Case Edge" frame-width="1" mouse-enabled="false" origin="470, 40" size="280, 62" text-alignment="center" title="TL  0–63&#10;FB  0–7&#10;Shared by the user patch" transparent="false"/>
    </view>

    <!-- Main operator controls, in the requested synthesis order. -->
    <view background-color="Panel" background-color-draw-style="filled and stroked" class="CViewContainer" frame-color="Panel Light" frame-width="1" origin="18, 200" size="784, 250" transparent="false">
      <view back-color="Panel" class="CTextLabel" font="~ NormalFontSmall" font-color="Muted" frame-width="0" mouse-enabled="false" origin="15, 8" size="754, 20" style-no-frame="true" text-alignment="left" title="OPERATOR — EG → MUL → AR → DR → SL → RR" transparent="true"/>
      <view back-color="Panel" class="CTextLabel" font="~ NormalFontSmaller" font-color="Ink" frame-width="0" mouse-enabled="false" origin="92, 34" size="80, 18" style-no-frame="true" text-alignment="center" title="EG (0/1)" transparent="true"/>
      <view back-color="Panel" class="CTextLabel" font="~ NormalFontSmaller" font-color="Ink" frame-width="0" mouse-enabled="false" origin="197, 34" size="80, 18" style-no-frame="true" text-alignment="center" title="MUL" transparent="true"/>
