      <view back-color="Screen" class="CTextLabel" font="~ NormalFontSmaller" font-color="LCD" frame-color="Case Edge" frame-width="1" mouse-enabled="false" origin="15, 58" size="62, 76" text-alignment="center" title="MODULATOR&#10;(M)" transparent="false"/>
      <view class="CTextButton" control-tag="EG0" default-value="1" font="~ NormalFontSmall" frame-color="Case Edge" frame-width="1" gradient="Default TextButton Gradient" gradient-highlighted="Default TextButton Gradient Highlighted" kick-style="false" origin="94, 58" round-radius="5" size="76, 50" text-color="Ink" text-color-highlighted="Accent" title="EG M"/>
      <view back-color="Screen" class="CTextEdit" control-tag="EG0" font="~ NormalFontSmaller" font-color="LCD" frame-color="Case Edge" frame-width="1" origin="102, 111" size="60, 22" text-alignment="center" transparent="false"/>
