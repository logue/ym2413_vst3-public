      <view angle-range="270" angle-start="135" circle-drawing="true" class="CKnob" control-tag="MUL1" corona-color="LCD" corona-drawing="true" corona-inset="6" default-value="0.0666667" handle-color="Ink" handle-line-width="3" origin="212, 150" size="50, 50" transparent="false" value-inset="7" wheel-inc-value="0.0666667"/>
