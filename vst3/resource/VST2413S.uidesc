    <!-- Secondary operator controls. -->
    <view background-color="Panel" background-color-draw-style="filled and stroked" class="CViewContainer" frame-color="Panel Light" frame-width="1" origin="18, 462" size="784, 170" transparent="false">
      <view back-color="Panel" class="CTextLabel" font="~ NormalFontSmall" font-color="Muted" frame-width="0" mouse-enabled="false" origin="15, 8" size="754, 20" style-no-frame="true" text-alignment="left" title="OPERATOR DETAIL — KSR → KSL → AM → VIB → DISTORTION" transparent="true"/>
