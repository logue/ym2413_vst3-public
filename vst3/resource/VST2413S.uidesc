      <view class="CTextButton" control-tag="EG1" default-value="1" font="~ NormalFontSmall" frame-color="Case Edge" frame-width="1" gradient="Default TextButton Gradient" gradient-highlighted="Default TextButton Gradient Highlighted" kick-style="false" origin="94, 150" round-radius="5" size="76, 50" text-color="Ink" text-color-highlighted="Accent" title="EG C"/>
