      <view back-color="Screen" class="CTextEdit" control-tag="MUL0" font="~ NormalFontSmaller" font-color="LCD" frame-color="Case Edge" frame-width="1" origin="207, 111" size="60, 22" text-alignment="center" transparent="false"/>
      <view angle-range="270" angle-start="135" circle-drawing="true" class="CKnob" control-tag="AR0" corona-color="Accent" corona-drawing="true" corona-inset="6" default-value="0" handle-color="Ink" handle-line-width="3" origin="317, 58" size="50, 50" transparent="false" value-inset="7" wheel-inc-value="0.0666667"/>
